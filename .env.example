# Copy to .env and fill in real values locally. .env is git-ignored and
# Claude Code is blocked from reading or editing it.

# Stripe sandbox (test mode). The app refuses to start unless this begins with sk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --project-name connect-prototype ...` (printed at startup)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe-hosted onboarding sends the reseller back to
APP_BASE_URL=http://localhost:8080

# Local Postgres from docker compose
DB_URL=jdbc:postgresql://localhost:5432/connect
DB_USERNAME=connect
DB_PASSWORD=change_me
