{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(~/.config/stripe/**)",
      "Edit(~/.config/stripe/**)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(*sk_live_*)",
      "Bash(stripe * --live*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(rm *)",
      "Bash(stripe listen *)"
    ],
    "allow": [
      "Bash(mvn test *)",
      "Bash(mvn verify *)",
      "Bash(mvn compile *)",
      "Bash(mvn package *)",
      "Bash(mvn spotless:apply *)",
      "Bash(mvn spotless:check *)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw verify *)",
      "Bash(./mvnw compile *)",
      "Bash(./mvnw package *)",
      "Bash(./mvnw spotless:apply *)",
      "Bash(./mvnw spotless:check *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git add *)",
      "Bash(bash .claude/hooks/tests/*)",
      "Bash(stripe trigger --project-name connect-prototype *)",
      "Bash(stripe events resend --project-name connect-prototype *)",
      "Bash(stripe logs tail --project-name connect-prototype *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowRead": ["./.env.example"]
    },
    "credentials": {
      "envVars": [
        { "name": "STRIPE_SECRET_KEY", "mode": "deny" },
        { "name": "STRIPE_WEBHOOK_SECRET", "mode": "deny" }
      ]
    },
    "excludedCommands": ["docker compose *", "stripe *"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
